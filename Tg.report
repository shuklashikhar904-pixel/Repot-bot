# ─────────────────────── MENU RENDER ──────────────────────────
async def show_user_menu(event, edit=False):
    uid = event.sender_id
    rec = register_user(uid)
    tag = "💎 premium" if is_premium(rec) else "🆓 free"
    days = premium_days_left(rec)
    extra = f" · {days}d left" if days else ""
    text = (
        f"**NIK report bot**\n"
        f"status: {tag}{extra}\n\n"
        f"report a username or channel — tap below."
    )
    btns = user_menu(is_admin_event(event))
    if edit:
        try:
            await event.edit(text, buttons=btns, parse_mode="md")
            return
        except Exception:
            pass
    await event.reply(text, buttons=btns, parse_mode="md")


async def show_admin_menu(event, edit=True):
    if not is_admin_event(event):
        try:
            await event.answer("not authorized", alert=True)
        except Exception:
            pass
        return
    if is_owner_event(event):
        text = "**⚙️ owner panel** — full control"
        btns = owner_menu()
    else:
        text = "**⚙️ admin panel** — link · add · report · grant premium"
        btns = admin_menu()
    if edit:
        try:
            await event.edit(text, buttons=btns, parse_mode="md")
            return
        except Exception:
            pass
    await event.reply(text, buttons=btns, parse_mode="md")


# ─────────────────────── COMMAND HANDLERS ─────────────────────
@bot.on(events.NewMessage(pattern=r"^/start"))
async def cmd_start(e):
    if not await gate_ok(e):
        return
    await show_user_menu(e)


@bot.on(events.NewMessage(pattern=r"^/(help|menu)"))
async def cmd_help(e):
    if not await gate_ok(e):
        return
    await show_user_menu(e)


@bot.on(events.NewMessage(pattern=r"^/admin"))
async def cmd_admin(e):
    if not is_admin_event(e):
        return
    if not await gate_ok(e):
        return
    await show_admin_menu(e, edit=False)


# ─────────────────────── CALLBACK ROUTER ──────────────────────
@bot.on(events.CallbackQuery())
async def on_button(event):
    uid = event.sender_id
    data = event.data.decode() if isinstance(event.data, bytes) else str(event.data)

    if data == "gate:check":
        return  # handled by its own handler

    if not await gate_ok(event):
        return

    register_user(uid)
    admin_user = is_admin_event(event)
    owner_user = is_owner_event(event)

    try:
        if data == "m:home":
            await show_user_menu(event, edit=True)
            return

        if data == "u:help":
            rec = register_user(uid)
            prem = is_premium(rec)
            body = (
                "**how to use**\n\n"
                "• 🚨 report user — report a `@username`\n"
                "• 📡 report channel — report a channel link / @username\n"
                "• 💎 my premium — check your status\n\n"
                + ("you have premium — reports enabled."
                   if prem else
                   "**no premium** — ask the admin to grant access.\n"
                   "reports are locked without premium.")
            )
            await event.edit(body, buttons=user_back(), parse_mode="md")
            return

        if data == "u:premium":
            rec = register_user(uid)
            if is_premium(rec):
                d = premium_days_left(rec)
                body = f"💎 **premium active**\n\n`{d}` day(s) remaining."
            else:
                body = "🆓 **free tier**\n\nno premium. contact the admin to unlock reports."
            await event.edit(body, buttons=user_back(), parse_mode="md")
            return

        if data == "u:report":
            rec = register_user(uid)
            if not is_premium(rec) and not admin_user:
                await event.answer("premium required", alert=True)
                await event.edit(
                    "🚫 **premium required**\n\nask the admin to grant you premium.",
                    buttons=user_back(), parse_mode="md",
                )
                return
            PENDING_REPORT[uid] = {"stage": "await_username"}
            await event.edit(
                "🚨 **report user**\n\nsend the target `@username` now.",
                buttons=[[Button.inline("◀️ cancel", b"m:home")]], parse_mode="md",
            )
            return

        if data == "u:report_ch":
            rec = register_user(uid)
            if not is_premium(rec) and not admin_user:
                await event.answer("premium required", alert=True)
                await event.edit(
                    "🚫 **premium required**\n\nask the admin to grant you premium.",
                    buttons=user_back(), parse_mode="md",
                )
                return
            PENDING_REPORT[uid] = {"stage": "await_channel"}
            await event.edit(
                "📡 **report channel**\n\nsend the channel `@name` or `https://t.me/name`.",
                buttons=[[Button.inline("◀️ cancel", b"m:home")]], parse_mode="md",
            )
            return

        if not admin_user:
            await event.answer("not authorized", alert=True)
            return

        if data == "a:home":
            await show_admin_menu(event, edit=True)
            return

        if data == "a:stats":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            await event.edit(render_status(), buttons=back_to("a:home"), parse_mode="md")
            return

        if data == "a:accounts":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            sessions = list_sessions()
            if not sessions:
                body = "no reporting accounts linked yet."
            else:
                assign = load_api_assign()
                lines = [f"**{len(sessions)} reporting accounts:**\n"]
                for s in sessions:
                    idx = assign.get(s, "?")
                    lines.append(f"• `{s[:-8]}` — API #{idx}")
                body = "\n".join(lines)
            await event.edit(body, buttons=back_to("a:home"), parse_mode="md")
            return

        if data == "a:api":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            assign = load_api_assign()
            counts = {}
            for sess, idx in assign.items():
                counts[idx] = counts.get(idx, 0) + 1
            lines = [f"**🔑 API pool ({len(API_POOL)} APIs loaded)**\n"]
            for i, entry in enumerate(API_POOL):
                aid, _, region, label = entry
                n = counts.get(i, 0)
                lines.append(f"• `{label}` · {region} · `{aid}` — `{n}` sessions")
            await event.edit("\n".join(lines), buttons=back_to("a:home"), parse_mode="md")
            return

        if data == "a:connect":
            await event.edit(
                "🔗 **link account**\n\npick an api pair to bind the next account to.",
                buttons=pair_buttons(), parse_mode="md",
            )
            return

        if data == "a:add":
            PENDING_ADD[event.chat_id] = True
            await event.edit(
                "➕ **add account**\n\nsend the phone number as `+1234567890`.",
                buttons=back_to("a:home"), parse_mode="md",
            )
            return

        if data == "a:remove":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            PENDING_REMOVE[event.chat_id] = True
            await event.edit(
                "➖ **remove account**\n\nsend the phone as `+1234567890`.",
                buttons=back_to("a:home"), parse_mode="md",
            )
            return

        if data == "a:premium":
            if owner_user:
                await event.edit("💎 **premium manager**", buttons=premium_menu_owner(), parse_mode="md")
            else:
                await event.edit("💎 **premium**", buttons=premium_menu_admin(), parse_mode="md")
            return

        if data == "a:p_grant":
            PENDING_PREMIUM_GRANT[event.chat_id] = {"stage": "await_id"}
            await event.edit(
                "➕ **grant premium**\n\nstep 1/2: send target's **numeric id** or `@username`.",
                buttons=back_to("a:premium"), parse_mode="md",
            )
            return

        if data == "a:p_revoke":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            PENDING_PREMIUM_REVOKE[event.chat_id] = {"stage": "await_id"}
            await event.edit(
                "➖ **revoke premium**\n\nsend target's **numeric id** or `@username`.",
                buttons=back_to("a:premium"), parse_mode="md",
            )
            return

        if data == "a:p_list":
            users = load_users()
            now = time.time()
            prem = [(k, v) for k, v in users.items() if v.get("premium_until", 0) > now]
            if not prem:
                body = "no premium users yet."
            else:
                lines = ["**💎 premium users**\n"]
                for k, v in prem:
                    days = int((v["premium_until"] - now) // 86400)
                    uname = v.get("username") or "—"
                    lines.append(f"• `{k}` (@{uname}) — `{days}d` left")
                body = "\n".join(lines)
            await event.edit(body, buttons=back_to("a:premium"), parse_mode="md")
            return

        if data == "a:users":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            users = load_users()
            now = time.time()
            if not users:
                body = "no users registered yet."
            else:
                lines = [f"**👤 users ({len(users)})**\n"]
                for k, v in list(users.items())[:80]:
                    tag = "💎" if v.get("premium_until", 0) > now else "🆓"
                    uname = v.get("username") or "—"
                    reps = v.get("reports_sent", 0)
                    lines.append(f"{tag} `{k}` (@{uname}) · reports: `{reps}`")
                body = "\n".join(lines)
            await event.edit(body, buttons=back_to("a:home"), parse_mode="md")
            return

        if data == "a:admins":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            admins = load_admins()
            lines = [f"**🛡 admins ({admin_count()}/{MAX_ADMINS})**\n"]
            for k, v in admins.items():
                if v.get("owner"):
                    continue
                if not v.get("admin"):
                    continue
                lines.append(f"• `{k}` (@{v.get('username','—')})")
            if admin_count() == 0:
                lines.append("(no admins yet)")
            rows = [
                [Button.inline("➕ add admin", b"a:add_admin"),
                 Button.inline("➖ remove admin", b"a:remove_admin")],
                [Button.inline("◀️ back", b"a:home")],
            ]
            await event.edit("\n".join(lines), buttons=rows, parse_mode="md")
            return

        if data == "a:add_admin":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            if admin_count() >= MAX_ADMINS:
                await event.answer(f"max {MAX_ADMINS} admins", alert=True); return
            PENDING_ADD_ADMIN[event.chat_id] = True
            await event.edit(
                f"➕ **add admin**\n\nsend: `user_id @username`\n\n"
                f"slots: `{admin_count()}/{MAX_ADMINS}`",
                buttons=back_to("a:admins"), parse_mode="md",
            )
            return

        if data == "a:remove_admin":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            admins = load_admins()
            rows = []
            for k, v in admins.items():
                if v.get("owner") or not v.get("admin"):
                    continue
                rows.append([Button.inline(f"❌ @{v.get('username','—')} ({k})", f"rmadm:{k}".encode())])
            if not rows:
                rows.append([Button.inline("(no admins)", b"noop")])
            rows.append([Button.inline("◀️ back", b"a:admins")])
            await event.edit("➖ **remove admin**", buttons=rows, parse_mode="md")
            return

        if data == "a:support":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            await event.edit(
                f"**📬 support**\n\nadmin username: @{ADMIN_USERNAME}\n\n"
                f"users can reach you there.",
                buttons=back_to("a:home"), parse_mode="md",
            )
            return

        if data == "a:reveal":
            if not owner_user:
                await event.answer("owner only", alert=True); return
            sessions = list_sessions()
            users = load_users()
            stats = load_stats()
            body = (
                f"**🔑 full reveal (owner only)**\n\n"
                f"**session dir:** `{SESSION_DIR}`\n"
                f"**accounts file:** `{ACCOUNTS_FILE}`\n"
                f"**users file:** `{USERS_FILE}`\n"
                f"**admins file:** `{ADMINS_FILE}`\n"
                f"**api pool size:** `{len(API_POOL)}`\n\n"
                f"**sessions ({len(sessions)}):**\n"
                + ("\n".join(f"• `{s}`" for s in sessions) if sessions else "  none")
                + f"\n\n**users:** `{len(users)}`\n**tracked targets:** `{len(stats)}`"
            )
            await event.edit(body, buttons=back_to("a:home"), parse_mode="md")
            return

        if data == "noop":
            await event.answer()
            return

        await event.answer()

    except Exception as ex:
        print(f"[!] callback error: {ex}")


@bot.on(events.CallbackQuery(pattern=rb"^pair:"))
async def cb_pair(event):
    if not is_admin_event(event):
        await event.answer("no access", alert=True); return
    if not await gate_ok(event):
        return
    idx = int(event.data.decode().split(":", 1)[1])
    if idx < 0 or idx >= len(API_POOL):
        await event.answer("bad api index", alert=True); return
    api_id, api_hash, region, label = API_POOL[idx]
    PENDING_CONNECT[event.chat_id] = {
        "stage": "await_phone",
        "api_id": api_id,
        "api_hash": api_hash,
        "region": region,
        "label": label,
    }
    await event.edit(
        f"🔗 **link account via {label}**\n\n"
        f"api_id: `{api_id}`\n\n"
        f"send the phone number now as `+1234567890`.",
        buttons=[[Button.inline("◀️ cancel", b"a:connect")]],
        parse_mode="md",
    )


@bot.on(events.CallbackQuery(pattern=rb"^rmadm:"))
async def cb_rmadm(event):
    if not is_owner_event(event):
        await event.answer("owner only", alert=True); return
    if not await gate_ok(event):
        return
    target = event.data.decode().split(":", 1)[1]
    ok = remove_admin(int(target))
    await event.answer("removed" if ok else "cannot remove owner", alert=True)
    admins = load_admins()
    lines = [f"**🛡 admins ({admin_count()}/{MAX_ADMINS})**\n"]
    for k, v in admins.items():
        if v.get("owner") or not v.get("admin"):
            continue
        lines.append(f"• `{k}` (@{v.get('username','—')})")
    if admin_count() == 0:
        lines.append("(no admins yet)")
    rows = [
        [Button.inline("➕ add admin", b"a:add_admin"),
         Button.inline("➖ remove admin", b"a:remove_admin")],
        [Button.inline("◀️ back", b"a:home")],
    ]
    await event.edit("\n".join(lines), buttons=rows, parse_mode="md")


# ─────────────────────── RENDER HELPERS ───────────────────────
def render_status():
    stats = load_stats()
    sessions = list_sessions()
    users = load_users()
    now = time.time()
    prem_count = sum(1 for v in users.values() if v.get("premium_until", 0) > now)
    head = (
        f"**📊 bot stats**\n\n"
        f"reporting accounts: `{len(sessions)}`\n"
        f"registered users: `{len(users)}`\n"
        f"premium users: `{prem_count}`\n"
        f"tracked targets: `{len(stats)}`\n"
        f"api pool: `{len(API_POOL)}`\n"
        f"admins: `{admin_count()}/{MAX_ADMINS}`\n"
    )
    if not stats:
        return head + "\nno reports fired yet."
    lines = [head, "\n**per-target:**"]
    for target, s in stats.items():
        lines.append(f"• @{target}: `{s['ok']} ok / {s['fail']} fail / {s['runs']} runs`")
    return "\n".join(lines)


# ─────────────────── CONNECT WIZARD ───────────────────────────
async def _advance_connect(event, chat_id):
    state = PENDING_CONNECT.get(chat_id)
    if not state:
        return
    phone = state.get("phone")
    api_id = state.get("api_id")
    api_hash = state.get("api_hash")
    region = state.get("region")
    label = state.get("label")
    if not phone or not api_id:
        PENDING_CONNECT.pop(chat_id, None)
        await event.respond("❌ connect state lost — start over.", buttons=back_to("a:connect"))
        return

    session_path = str(SESSION_DIR / phone.replace("+", ""))
    sess_name = os.path.basename(session_path) + ".session"
    client = TelegramClient(session_path, api_id, api_hash)
    state["client"] = client
    state["stage"] = "requesting"

    print(f"[*] connect {phone} via {label} (api={api_id})")

    try:
        await client.connect()
        if await client.is_user_authorized():
            me = await client.get_me()
            await client.disconnect()
            save_session_api(sess_name, api_id, api_hash, region, label)
            PENDING_CONNECT.pop(chat_id, None)
            await event.respond(
                f"✅ `{phone}` already linked as `{me.username or me.id}` via {label}",
                buttons=back_to("a:home"),
            )
            return

        sent = await client.send_code_request(phone)
        state["phone_code_hash"] = sent.phone_code_hash
        state["stage"] = "await_code"

        code_type = getattr(sent, "type", None)
        type_name = type(code_type).__name__ if code_type else "unknown"
        print(f"[*] code requested for {phone} · type={type_name}")

        await event.respond(
            f"📲 code requested for `{phone}`.\n"
            f"delivery: `{type_name}`\n"
            f"api: `{label}` (`{api_id}`)\n\n"
            f"check the Telegram app on that account first.\n"
            f"send the code here when it arrives.",
            buttons=back_to("a:home"),
        )

    except FloodWaitError as ex:
        try:
            await client.disconnect()
        except Exception:
            pass
        PENDING_CONNECT.pop(chat_id, None)
        await event.respond(
            f"⏳ **flood wait** for `{phone}`: `{ex.seconds}s`",
            buttons=back_to("a:home"),
        )
        return
    except Exception as ex:
        try:
            await client.disconnect()
        except Exception:
            pass
        PENDING_CONNECT.pop(chat_id, None)
        print(f"[!] send_code_request failed {phone}: {type(ex).__name__}: {ex}")
        await event.respond(
            f"❌ `{phone}` failed:\n`{human_error(ex)}`",
            buttons=back_to("a:home"),
        )
        return


# ─────────────────────── MESSAGE WATCHER ──────────────────────
@bot.on(events.NewMessage())
async def watcher(event):
    if event.out:
        return
    text = (event.raw_text or "").strip()
    if not text or text.startswith("/"):
        return

    uid = event.sender_id
    chat_id = event.chat_id
    admin_user = is_admin_event(event)
    owner_user = is_owner_event(event)

    # gate check on non-command text
    if not owner_user:
        try:
            if not await is_joined_required(uid):
                return
        except Exception:
            return

    state = PENDING_CONNECT.get(chat_id)

    if state and admin_user:
        stage = state.get("stage")
        client = state.get("client")
        phone = state.get("phone")

        if stage == "await_phone":
            p = text.strip()
            if not p.startswith("+"):
                p = "+" + p
            state["phone"] = p
            await _advance_connect(event, chat_id)
            return

        if stage == "await_code":
            try:
                await client.sign_in(phone, text, phone_code_hash=state["phone_code_hash"])
                me = await client.get_me()
                await client.disconnect()
                sess_name = os.path.basename(str(SESSION_DIR / phone.replace("+", ""))) + ".session"
                save_session_api(sess_name, state["api_id"], state["api_hash"],
                                 state["region"], state["label"])
                print(f"[+] linked {phone} as {me.username or me.id}")
                await event.reply(f"✅ `{phone}` linked as `{me.username or me.id}` via {state['label']}")
                PENDING_CONNECT.pop(chat_id, None)
                return
            except SessionPasswordNeededError:
                state["stage"] = "await_password"
                await event.reply(f"🔐 2fa required for `{phone}` — send the password.")
                return
            except PhoneCodeInvalidError:
                await event.reply("❌ wrong code. send it again.")
                return
            except PhoneCodeExpiredError:
                await event.reply("❌ code expired. tap link account to restart.")
                                     try:
                    await client.disconnect()
                except Exception:
                    pass
                PENDING_CONNECT.pop(chat_id, None)
                return
            except FloodWaitError as ex:
                await event.reply(f"⏳ flood wait — `{ex.seconds}s`.")
                try:
                    await client.disconnect()
                except Exception:
                    pass
                PENDING_CONNECT.pop(chat_id, None)
                return
            except Exception as ex:
                await event.reply(f"❌ code rejected:\n`{human_error(ex)}`")
                try:
                    await client.disconnect()
                except Exception:
                    pass
                PENDING_CONNECT.pop(chat_id, None)
                return

        if stage == "await_password":
            try:
                await client.sign_in(password=text)
                me = await client.get_me()
                await client.disconnect()
                sess_name = os.path.basename(str(SESSION_DIR / phone.replace("+", ""))) + ".session"
                save_session_api(sess_name, state["api_id"], state["api_hash"],
                                 state["region"], state["label"])
                await event.reply(f"✅ `{phone}` linked as `{me.username or me.id}` (2fa)")
                PENDING_CONNECT.pop(chat_id, None)
                return
            except PasswordHashInvalidError:
                await event.reply("❌ wrong 2fa password. send it again.")
                return
            except Exception as ex:
                await event.reply(f"❌ 2fa failed:\n`{human_error(ex)}`")
                try:
                    await client.disconnect()
                except Exception:
                    pass
                PENDING_CONNECT.pop(chat_id, None)
                return

    if admin_user and chat_id in PENDING_ADD:
        PENDING_ADD.pop(chat_id, None)
        phone = text.strip()
        if not phone.startswith("+"):
            phone = "+" + phone
        added = append_account(phone)
        await event.reply(
            f"{'queued' if added else 'already queued'} `{phone}`. tap 🔗 link account.",
            buttons=back_to("a:home"), parse_mode="md",
        )
        return

    if owner_user and chat_id in PENDING_REMOVE:
        PENDING_REMOVE.pop(chat_id, None)
        phone = text.strip()
        if not phone.startswith("+"):
            phone = "+" + phone
        removed = remove_account(phone)
        await event.reply(f"{'unlinked' if removed else 'not found'}: `{phone}`",
                          buttons=back_to("a:home"), parse_mode="md")
        return

    if owner_user and chat_id in PENDING_ADD_ADMIN:
        PENDING_ADD_ADMIN.pop(chat_id, None)
        parts = text.split()
        if len(parts) < 2 or not parts[0].isdigit():
            await event.reply("format: `123456789 @username`")
            return
        new_id = int(parts[0])
        uname = parts[1].lstrip("@")
        if admin_count() >= MAX_ADMINS:
            await event.reply(f"max {MAX_ADMINS} admins reached.")
            return
        add_admin(new_id, uname)
        await event.reply(f"✅ admin added: `{new_id}` (@{uname})",
                          buttons=back_to("a:admins"), parse_mode="md")
        return

    if admin_user and chat_id in PENDING_PREMIUM_GRANT:
        st = PENDING_PREMIUM_GRANT[chat_id]
        if st["stage"] == "await_id":
            st["target"] = text.strip()
            st["stage"] = "await_days"
            await event.reply(
                f"target: `{st['target']}`\n\n**step 2/2: how many days?**",
                buttons=back_to("a:premium"), parse_mode="md",
            )
            return
        if st["stage"] == "await_days":
            try:
                days = int(text.strip())
                if days <= 0:
                    raise ValueError
            except ValueError:
                await event.reply("send a positive integer.")
                return
            PENDING_PREMIUM_GRANT.pop(chat_id, None)
            await _grant_premium(event, st["target"], days)
            return

    if owner_user and chat_id in PENDING_PREMIUM_REVOKE:
        PENDING_PREMIUM_REVOKE.pop(chat_id, None)
        await _revoke_premium(event, text.strip())
        return

    rstate = PENDING_REPORT.get(uid)
    if rstate:
        stage = rstate.get("stage")
        if stage == "await_username":
            if not USERNAME_RE.match(text):
                await event.reply("not a valid username. try `@name`.")
                return
            PENDING_REPORT.pop(uid, None)
            await fire_report_flow(event, text.strip(), kind="username")
            return
        if stage == "await_channel":
            ref = text.strip()
            if not (USERNAME_RE.match(ref) or "t.me/" in ref):
                await event.reply("send a channel `@name` or `https://t.me/name`.")
                return
            PENDING_REPORT.pop(uid, None)
            await fire_report_flow(event, ref, kind="channel")
            return

    if USERNAME_RE.match(text):
        if admin_user:
            return
        rec = register_user(uid)
        if not is_premium(rec):
            await event.reply("🚫 premium required. tap 💎 my premium.")
            return
        await fire_report_flow(event, text.strip(), kind="username")


# ─────────────────── PREMIUM GRANT/REVOKE ─────────────────────
async def _resolve_target_key(target: str):
    t = target.strip().lstrip("@")
    if t.isdigit():
        return t
    t = t.replace("https://t.me/", "").replace("http://t.me/", "").split("/")[0]
    try:
        ent = await bot.get_entity("@" + t)
        return str(ent.id)
    except Exception:
        return None


async def _grant_premium(event, target: str, days: int):
    key = await _resolve_target_key(target)
    if not key:
        await event.reply(f"❌ couldn't resolve `{target}`.")
        return
    users = load_users()
    rec = users.get(key, {
        "username": target.lstrip("@") if not target.lstrip("@").isdigit() else "",
        "premium_until": 0,
        "first_seen": int(time.time()),
        "reports_sent": 0,
    })
    now = time.time()
    base = rec["premium_until"] if rec["premium_until"] > now else now
    rec["premium_until"] = int(base + days * 86400)
    users[key] = rec
    save_users(users)
    await event.reply(
        f"✅ premium granted\n`{key}` for **{days} day(s)**\nexpires: "
        f"`{time.strftime('%Y-%m-%d %H:%M', time.localtime(rec['premium_until']))}`",
        buttons=back_to("a:premium"), parse_mode="md",
    )


async def _revoke_premium(event, target: str):
    key = await _resolve_target_key(target)
    if not key:
        await event.reply(f"❌ couldn't resolve `{target}`.")
        return
    users = load_users()
    if key not in users:
        await event.reply(f"`{key}` not registered.")
        return
    users[key]["premium_until"] = 0
    save_users(users)
    await event.reply(f"✅ premium revoked for `{key}`.",
                      buttons=back_to("a:premium"), parse_mode="md")


# ─────────────────── REPORT FLOW ──────────────────────────────
async def fire_report_flow(event, target_ref, kind="username"):
    uid = event.sender_id
    sessions = list_sessions()
    label = "channel" if kind == "channel" else "user"
    msg = await event.reply(f"🚨 firing on **{label}** `{target_ref}` from `{len(sessions)}` accounts…")

    async def progress(done, total, ok):
        try:
            await msg.edit(f"🚨 `{target_ref}` — `{done}/{total}` done · `{ok}` ok")
        except Exception:
            pass

    summary = await run_report(target_ref, progress_cb=progress)

    if summary.get("error"):
        await msg.edit(f"[x] {summary['error']}")
        return

    users = load_users()
    key = str(uid)
    if key in users:
        users[key]["reports_sent"] = users[key].get("reports_sent", 0) + 1
        save_users(users)

    out = (
        f"✅ **report sent**\n\n"
        f"target: `{target_ref}`\n"
        f"`{summary['ok']}/{summary['total']}` ok · `{summary['fail']}` fail"
    )
    fails = [r for r in summary["results"] if not r["ok"]]
    if fails:
        out += "\n\n**failed sessions:**\n" + "\n".join(
            f"• `{r['session'][:-8]}`: {r['error'][:90]}" for r in fails[:10]
        )
    await msg.edit(out, buttons=user_back(), parse_mode="md")


# ─────────────────────────── MAIN ─────────────────────────────
async def main():
    global OWNER_ID

    print(f"[*] starting bot ... (api pool: {len(API_POOL)})")
    await bot.start(bot_token=BOT_TOKEN)
    print("[*] bot authorized.")

    admins = load_admins()
    seeded_owner = None
    for k, v in admins.items():
        if v.get("owner"):
            seeded_owner = int(k)
            break

    try:
        entity = await bot.get_entity("@" + ADMIN_USERNAME)
        OWNER_ID = entity.id
        print(f"[*] owner resolved: @{ADMIN_USERNAME} (id={OWNER_ID})")
        admins[str(OWNER_ID)] = {"username": ADMIN_USERNAME, "owner": True, "admin": True}
        save_admins(admins)
        register_user(OWNER_ID, ADMIN_USERNAME)
    except Exception as e:
        print(f"[!] could not resolve owner @{ADMIN_USERNAME}: {e}")
        if seeded_owner:
            OWNER_ID = seeded_owner
            print(f"[*] owner loaded from admins.json: {OWNER_ID}")

    print("[*] bot online.")
    print(f"[*] linked reporting accounts: {len(list_sessions())}")
    print("[*] send /start to open your menu.")

    await bot.run_until_disconnected()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n[*] shut down.")
    except Exception as e:
        print(f"[!] fatal: {e}")

def is_owner_event(event):
    return event.sender_id == OWNER_ID or is_owner(event.sender_id)


def is_admin_event(event):
    return is_admin(event.sender_id)


# ─────────────────── JOIN GATE ────────────────────────────────
GATE_TEXT = (
    "**⚠️ JOIN REQUIRED**\n\n"
    "you must be a member of **both** channels:\n"
    f"• @{REQUIRED_CHANNELS[0]}\n"
    f"• @{REQUIRED_CHANNELS[1]}\n\n"
    "tap below to join, then ✅ I JOINED."
)


def join_gate_buttons():
    rows = []
    for ch in REQUIRED_CHANNELS:
        rows.append([Button.url(f"📢 JOIN @{ch}", f"https://t.me/{ch}")])
    rows.append([Button.inline("✅ I JOINED — retry", b"gate:check")])
    return rows


async def is_joined_required(uid: int) -> bool:
    for ch in REQUIRED_CHANNELS:
        try:
            await bot.get_permissions(ch, uid)
        except UserNotParticipantError:
            return False
        except (ChannelPrivateError, ValueError):
            return False
        except Exception:
            return False
    return True


async def gate_ok(event) -> bool:
    uid = event.sender_id
    if is_owner_event(event):
        return True
    try:
        joined = await is_joined_required(uid)
    except Exception:
        joined = False
    if joined:
        return True
    try:
        sender = await event.get_sender()
        uname = getattr(sender, "username", None)
    except Exception:
        uname = None
    if not is_admin_event(event):
        register_user(uid, uname)
    try:
        await event.respond(GATE_TEXT, buttons=join_gate_buttons())
    except Exception:
        pass
    return False


@bot.on(events.CallbackQuery(pattern=rb"^gate:check$"))
async def cb_gate_check(event):
    uid = event.sender_id
    try:
        sender = await event.get_sender()
        uname = getattr(sender, "username", None)
    except Exception:
        uname = None
    if not is_admin_event(event):
        register_user(uid, uname)
    if await is_joined_required(uid):
        await event.edit(
            "**NIK bot**\n\njoin verified. send /start.",
            buttons=[[Button.inline("🏠 menu", b"m:home")]],
        )
    else:
        await event.answer("still not in both channels", alert=True)



# ─────────────────────── JSON PERSISTENCE ─────────────────────
def _load(path, default):
    if path.exists():
        try:
            return json.loads(path.read_text())
        except Exception:
            return default
    return default


def _save(path, data):
    try:
        path.write_text(json.dumps(data, indent=2))
    except Exception as e:
        print(f"[!] save failed {path}: {e}")


def load_users():
    return _load(USERS_FILE, {})


def save_users(u):
    _save(USERS_FILE, u)


def load_stats():
    return _load(STATS_FILE, {})


def save_stats(s):
    _save(STATS_FILE, s)


def load_admins():
    return _load(ADMINS_FILE, {})


def save_admins(a):
    _save(ADMINS_FILE, a)


def load_api_assign():
    return _load(API_ASSIGN_FILE, {})


def save_api_assign(d):
    _save(API_ASSIGN_FILE, d)


def load_session_api():
    return _load(SESSION_API_FILE, {})


def save_session_api(name, api_id, api_hash, region, label):
    d = load_session_api()
    d[name] = {"api_id": api_id, "api_hash": api_hash, "region": region, "label": label}
    _save(SESSION_API_FILE, d)


def get_session_api(name):
    e = load_session_api().get(name)
    if not e:
        return None
    return e["api_id"], e["api_hash"]


def pick_api_for_session(session_name):
    """Return the api pair bound to this session, or pick+save a default."""
    bound = get_session_api(session_name)
    if bound:
        for entry in API_POOL:
            if entry[0] == bound[0] and entry[1] == bound[1]:
                return entry
    assign = load_api_assign()
    if session_name in assign:
        idx = assign[session_name]
        if isinstance(idx, int) and 0 <= idx < len(API_POOL):
            return API_POOL[idx]
    idx = _random.randrange(len(API_POOL))
    assign[session_name] = idx
    save_api_assign(assign)
    return API_POOL[idx]


# ─────────────────────── ADMIN LOGIC ──────────────────────────
def is_owner(user_id):
    a = load_admins()
    entry = a.get(str(user_id))
    return bool(entry and entry.get("owner"))


def is_admin(user_id):
    if is_owner(user_id):
        return True
    a = load_admins()
    entry = a.get(str(user_id))
    return bool(entry and entry.get("admin"))


def admin_count():
    a = load_admins()
    return sum(1 for v in a.values() if v.get("admin") and not v.get("owner"))


def add_admin(uid, username):
    a = load_admins()
    a[str(uid)] = {"username": username, "admin": True, "owner": False}
    save_admins(a)


def remove_admin(uid):
    a = load_admins()
    entry = a.get(str(uid))
    if entry and entry.get("owner"):
        return False
    a.pop(str(uid), None)
    save_admins(a)
    return True


# ─────────────────────────── HELPERS ──────────────────────────
def list_sessions():
    try:
        return sorted([f for f in os.listdir(SESSION_DIR) if f.endswith(".session")])
    except Exception:
        return []


def append_account(phone: str):
    if not ACCOUNTS_FILE.exists():
        ACCOUNTS_FILE.write_text("")
    existing = [l.strip() for l in ACCOUNTS_FILE.read_text().splitlines() if l.strip()]
    if phone in existing:
        return False
    with ACCOUNTS_FILE.open("a") as f:
        f.write(phone + "\n")
    return True


def remove_account(phone: str):
    sess = SESSION_DIR / (phone.replace("+", "") + ".session")
    removed = False
    if sess.exists():
        try:
            sess.unlink()
            removed = True
        except Exception:
            pass
    journal = SESSION_DIR / (phone.replace("+", "") + ".session-journal")
    if journal.exists():
        try:
            journal.unlink()
        except Exception:
            pass
    if ACCOUNTS_FILE.exists():
        lines = [l for l in ACCOUNTS_FILE.read_text().splitlines() if l.strip() != phone]
        ACCOUNTS_FILE.write_text("\n".join(lines) + ("\n" if lines else ""))
    d = load_session_api()
    d.pop(phone.replace("+", "") + ".session", None)
    _save(SESSION_API_FILE, d)
    return removed


def is_premium(rec):
    if not rec:
        return False
    return rec.get("premium_until", 0) > time.time()


def premium_days_left(rec):
    if not rec:
        return 0
    until = rec.get("premium_until", 0)
    if until <= time.time():
        return 0
    return int((until - time.time()) // 86400)


def register_user(uid, username=None):
    users = load_users()
    key = str(uid)
    if key not in users:
        users[key] = {
            "username": username or "",
            "premium_until": 0,
            "first_seen": int(time.time()),
            "reports_sent": 0,
        }
        save_users(users)
    elif username and users[key].get("username") != username:
        users[key]["username"] = username
        save_users(users)
    return users[key]


def human_error(ex):
    if isinstance(ex, FloodWaitError):
        return f"rate limited — wait {ex.seconds}s before retrying"
    if isinstance(ex, PhoneNumberInvalidError):
        return "phone number invalid — use full +countrycode format"
    if isinstance(ex, ApiIdInvalidError):
        return "API_ID/API_HASH pair is wrong — check my.telegram.org"
    if isinstance(ex, AuthKeyUnregisteredError):
        return "session key invalid — delete sessions/+<number>.session and retry"
    if isinstance(ex, SendCodeUnavailableError):
        return "telegram refuses to send codes to this number right now — try again later"
    if isinstance(ex, PhoneCodeInvalidError):
        return "wrong code — try again"
    if isinstance(ex, PhoneCodeExpiredError):
        return "code expired — tap connect again"
    if isinstance(ex, PasswordHashInvalidError):
        return "wrong 2fa password"
    return f"{type(ex).__name__}: {ex}"


# ─────────────────────── REASON RESOLVER ──────────────────────
def get_reason_obj(name: str):
    key = name.strip().lower()
    suffix_map = {
        "spam": "Spam", "violence": "Violence", "drugs": "IllegalDrugs",
        "illegal": "IllegalDrugs", "personal": "PersonalDetails",
        "copyright": "Copyright", "other": "Other", "fake": "Fake",
        "porn": "Pornography", "child": "ChildAbuse",
    }
    suffix = suffix_map.get(key, "Spam")
    for c in (f"InputReportReason{suffix}", f"ReportReason{suffix}"):
        cls = getattr(types, c, None)
        if cls is not None:
            try:
                return cls()
            except Exception:
                continue
    return None


def get_reason_bytes(name: str) -> bytes:
    obj = get_reason_obj(name)
    if obj is None:
        return b""
    try:
        return bytes(obj)
    except Exception:
        return b""


# ─────────────────────────── REPORTER ─────────────────────────
async def _do_report(client, peer, reason_obj, reason_bytes, message):
    """Try account.reportPeer (works on users), then messages.report (channels)."""
    errors = []

    # 1) account.ReportPeerRequest — the correct API for user peers
    try:
        req = functions.account.ReportPeerRequest(peer=peer, reason=reason_obj, message=message)
        await client(req)
        return
    except Exception as e:
        errors.append(f"reportPeer: {type(e).__name__}: {str(e)[:120]}")

    # 2) messages.ReportRequest with bytes option
    try:
        req = functions.messages.ReportRequest(peer=peer, id=[], option=reason_bytes, message=message)
        await client(req)
        return
    except Exception as e:
        errors.append(f"msgs.bytes: {type(e).__name__}: {str(e)[:120]}")

    # 3) messages.ReportRequest with obj option (older telethon)
    try:
        req = functions.messages.ReportRequest(peer=peer, id=[], option=reason_obj, message=message)
        await client(req)
        return
    except Exception as e:
        errors.append(f"msgs.obj: {type(e).__name__}: {str(e)[:120]}")

    raise RuntimeError(" | ".join(errors))


async def report_from_session(session_path, target_ref, reason_name, message):
    session_name = os.path.basename(session_path)
    _api = pick_api_for_session(session_name)
    _api_id, _api_hash = _api[0], _api[1]
    client = TelegramClient(session_path, _api_id, _api_hash)
    result = {"session": session_name, "ok": False, "error": None}
    try:
        await client.connect()
        if not await client.is_user_authorized():
            result["error"] = "not_authorized"
            return result
        try:
            target = await client.get_entity(target_ref)
        except Exception as e:
            result["error"] = f"resolve_fail: {str(e)[:120]}"
            return result
        peer = await client.get_input_entity(target)
        reason_obj = get_reason_obj(reason_name) or get_reason_obj("spam")
        reason_bytes = get_reason_bytes(reason_name)
        await _do_report(client, peer, reason_obj, reason_bytes, message)
        result["ok"] = True
    except FloodWaitError as e:
        result["error"] = f"flood_wait: {e.seconds}s"
    except Exception as e:
        result["error"] = f"{type(e).__name__}: {str(e)[:180]}"
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    return result


async def run_report(target_ref: str, progress_cb=None):
    sessions = list_sessions()
    if not sessions:
        return {"error": "no_sessions_linked", "total": 0, "ok": 0, "fail": 0, "results": []}

    _random.shuffle(sessions)

    clean = target_ref.strip()
    clean = clean.replace("https://t.me/", "").replace("http://t.me/", "")
    clean = clean.lstrip("@").split("/")[0]
    target_key = clean

    results = []
    ok_count = 0

    for i, sess in enumerate(sessions, 1):
        path = str(SESSION_DIR / sess)

        reason_name = _random.choice(REPORT_REASONS)
        msg_text = _random.choice(REPORT_MESSAGES)

        try:
            r = await report_from_session(path, clean, reason_name, msg_text)
        except Exception as e:
            r = {"session": sess, "ok": False, "error": f"crash: {str(e)[:120]}"}
        r["reason_used"] = reason_name
        results.append(r)
        if r["ok"]:
            ok_count += 1
        if progress_cb:
            try:
                await progress_cb(i, len(sessions), ok_count)
            except Exception:
                pass
        if i < len(sessions):
            await asyncio.sleep(_random.uniform(30, 180))

    summary = {
        "target": target_key, "total": len(sessions),
        "ok": ok_count, "fail": len(sessions) - ok_count, "results": results,
    }
    stats = load_stats()
    stats.setdefault(target_key, {"ok": 0, "fail": 0, "runs": 0})
    stats[target_key]["ok"] += ok_count
    stats[target_key]["fail"] += summary["fail"]
    stats[target_key]["runs"] += 1
    save_stats(stats)
    return summary


